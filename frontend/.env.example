# Staybooker frontend — build-time environment variables (Vite).
# Copy to .env.local for local development. On Cloudflare Pages these are set
# in the project's build environment.
#
# NOTE: production hostnames (staybooker.ai, *.pages.dev, railway.app) are
# resolved at runtime in src/core/api/baseUrl.ts and src/core/lib/supabase.ts,
# so a production build works without any of these. They exist for local dev
# and self-hosted deployments.

# Backend API origin. '/api/v1' is appended automatically if missing.
# Local dev default (unset): requests go to the Vite proxy at /api/v1.
VITE_API_URL=http://localhost:8000

# Supabase project (auth). Anon key is public by design — never put the
# service-role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Error reporting DSN (Sentry/GlitchTip). Leave empty to disable.
VITE_SENTRY_DSN=

# Cloudflare Turnstile site key for the login/signup/reset captcha.
VITE_TURNSTILE_SITE_KEY=
