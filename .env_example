# ============================================================================
# Staybooker — Environment Variable Template
# ============================================================================
# Copy this file to `.env` (which is gitignored) and fill in real values.
# NEVER commit real secrets to the repo. All values below are placeholders.
# If a real secret was ever committed here, ROTATE it immediately in the
# provider dashboard — git history retains old values until purged.
# ============================================================================

# --- Core ---
CORS_ORIGINS=""                      # comma-separated allowed origins
API_URL=""                           # public API base URL, e.g. https://api.staybooker.ai
DATABASE_URL=""                      # postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DB
DEBUG="False"                        # MUST be False in production
SECRET_KEY=""                        # app signing key (generate: openssl rand -hex 32)
LOG_LEVEL="INFO"                     # DEBUG only for local development

# --- Reverse proxy (rate-limit correctness) ---
# Railway only = 1, Cloudflare proxy -> Railway = 2. See config.py for details.
TRUSTED_PROXY_COUNT="1"

# --- Supabase (Auth + Postgres) ---
SUPABASE_URL=""
SUPABASE_ANON_KEY=""                 # safe to expose to the frontend
SUPABASE_JWKS_URL=""
SUPABASE_JWT_SECRET=""               # for local HS256 verification (optional)
# SERVICE ROLE KEY = FULL DATABASE BYPASS. Backend-only. Never expose to client,
# never commit. Store in your host's secret manager (Railway variables).
SUPABASE_SERVICE_ROLE_KEY=""

# --- Redis (cache + rate limiting) ---
REDIS_HOST=""
REDIS_PORT="6379"
REDIS_PASSWORD=""

# --- Email (Brevo) ---
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="noreply@example.com"
BREVO_SENDER_NAME="Staybooker"

# --- Observability ---
SENTRY_DSN=""

# --- Google OAuth / Business ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Rate shopping / scraping ---
SCRAPINGBEE_API_KEY=""

# --- WhatsApp (Meta Cloud API) ---
WHATSAPP_APP_SECRET=""               # for X-Hub-Signature-256 verification
WHATSAPP_VERIFY_TOKEN=""             # webhook verification handshake token

# --- AI (Groq) ---
GROQ_API_KEY=""

# --- Razorpay (payments) ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""           # separate signing key from KEY_SECRET
