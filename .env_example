# ============================================================================
# Staybooker — Environment Variable Template
# ============================================================================
# Copy this file to `.env` (which is gitignored) and fill in real values.
# NEVER commit real secrets to the repo. All values below are placeholders.
# If a real secret was ever committed here, ROTATE it immediately in the
# provider dashboard — git history retains old values until purged.
# ============================================================================

# --- Core ---
CORS_ORIGINS=""                      # comma-separated allowed origins
API_URL=""                           # public API base URL, e.g. https://api.staybooker.ai
DATABASE_URL=""                      # postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DB
DEBUG="False"                        # MUST be False in production
SECRET_KEY=""                        # app signing key (generate: openssl rand -hex 32)
LOG_LEVEL="INFO"                     # DEBUG only for local development

# --- Reverse proxy (rate-limit correctness) ---
# Railway only = 1, Cloudflare proxy -> Railway = 2. See config.py for details.
TRUSTED_PROXY_COUNT="1"

# --- Supabase (Auth + Postgres) ---
SUPABASE_URL=""
# NOTE: ANON_KEY and JWKS_URL are consumed by the FRONTEND build
# (frontend/.env.example), not by backend config.py — kept here only as a
# deployment checklist reminder.
SUPABASE_ANON_KEY=""                 # safe to expose to the frontend
SUPABASE_JWKS_URL=""
SUPABASE_JWT_SECRET=""               # for local HS256 verification (optional)
# SERVICE ROLE KEY = FULL DATABASE BYPASS. Backend-only. Never expose to client,
# never commit. Store in your host's secret manager (Railway variables).
SUPABASE_SERVICE_ROLE_KEY=""

# --- Redis (cache + rate limiting) ---
REDIS_HOST=""
REDIS_PORT="6379"
REDIS_PASSWORD=""

# --- Email (Brevo) ---
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="noreply@example.com"
BREVO_SENDER_NAME="Staybooker"

# --- Observability ---
SENTRY_DSN=""

# --- Google OAuth / Business ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Rate shopping / scraping ---
SCRAPINGBEE_API_KEY=""

# --- WhatsApp (Meta Cloud API) ---
WHATSAPP_APP_SECRET=""               # for X-Hub-Signature-256 verification
WHATSAPP_VERIFY_TOKEN=""             # webhook verification handshake token

# --- AI (Groq) ---
GROQ_API_KEY=""

# --- Razorpay (payments) ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""           # separate signing key from KEY_SECRET

# --- Public URLs ---
FRONTEND_URL=""                      # e.g. https://staybooker.ai — used in guest emails/links

# --- Redis (alternative single-URL form; overrides HOST/PORT/PASSWORD) ---
REDIS_URL=""                         # e.g. redis://default:pass@host:6379
REDIS_RETRY_COOLDOWN_SECONDS="30"    # in-memory fallback window after a Redis failure

# --- Platform admin (SECURITY-CRITICAL) ---
# Comma-separated emails auto-promoted to SUPER_ADMIN on login
# (app/core/auth/deps.py). Leave empty unless you understand the implications.
MASTER_ADMIN_EMAILS=""

# --- Central WhatsApp (platform-level sender, optional) ---
META_GRAPH_API_VERSION="v25.0"       # one Graph API version for every Meta call
CENTRAL_WHATSAPP_PHONE_ID=""
CENTRAL_WHATSAPP_TOKEN=""
SUPER_ADMIN_WHATSAPP=""              # platform number for booking alerts; empty = disabled
HOTEL_NOTIFICATION_EMAILS=""         # comma-separated ops alert inboxes

# --- AI cost & abuse guards ---
OPENAI_API_KEY=""                    # optional fallback provider
AI_TOOL_CALL_LIMIT="10"
AI_MAX_TOOL_CALLS_FROM_HISTORY="20"
AI_MAX_MESSAGE_CHARS="4000"
AI_CONFIRM_TIMEOUT_SECONDS="300"

# --- Auth token lifetimes ---
ACCESS_TOKEN_EXPIRE_MINUTES="30"
REFRESH_TOKEN_EXPIRE_DAYS="7"
BOOKING_TOKEN_REQUIRED="False"       # anti-bot token gate on public bookings
BOOKING_TOKEN_TTL_SECONDS="1800"

# --- Database pool (keep POOL_SIZE x WEB_CONCURRENCY x replicas <= Supabase limit) ---
DB_POOL_SIZE="5"
DB_MAX_OVERFLOW="5"
DB_POOL_RECYCLE="1800"
DB_POOL_TIMEOUT="30"

# --- Process / scheduler ---
WEB_CONCURRENCY="2"                  # gunicorn workers (Dockerfile)
PORT="8000"
ENABLE_SCHEDULER="True"              # background jobs (recovery sweeps, refreshes)
GEOIP_DB_PATH=""                     # optional MaxMind GeoLite2 path for visitor geo
