# Keep secrets and local cruft out of the build context / image.
**/.env
**/.env.*
!**/.env.example
secrets.json

# VCS & CI
.git
.github
.gitignore

# Python
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
backend/venv
backend/.venv

# Node / frontend (backend image doesn't need these)
frontend/node_modules
frontend/dist
**/node_modules

# Editor / OS
.vscode
.idea
.DS_Store
**/*.log

# Docs & local tooling
docs
decodo-api-docs
*.md
cloudflared_config.yml
